// Aster Animation Studio ERP — data model.
//
// Hierarchy that everything else hangs off (spec 55, 103):
//   Client > Project > Episode > Scene > Shot > ShotStage
//                                 Shot > Task > Version > Review > Revision
//
// Conventions: UUID primary keys, createdAt/updatedAt everywhere,
// deletedAt where soft delete is meaningful (spec 54).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

/// Interface languages: Russian (the source), Uzbek (Latin script), English, Turkish.
enum Locale {
  ru
  uz
  en
  tr
}

enum Role {
  OWNER
  ADMIN
  PRODUCER
  PROJECT_MANAGER
  ART_DIRECTOR
  ARTIST
  CLIENT
  FINANCE
}

enum ProjectType {
  ANIMATION_2D  @map("2D_ANIMATION")
  ANIMATION_3D  @map("3D_ANIMATION")
  MOTION_DESIGN
  COMMERCIAL
  SHORT_FILM
  SERIES
  FEATURE_FILM
  OTHER
}

enum ProjectStatus {
  DRAFT
  PLANNING
  PRE_PRODUCTION
  PRODUCTION
  POST_PRODUCTION
  CLIENT_REVIEW
  DELIVERY
  COMPLETED
  ON_HOLD
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StageStatus {
  NOT_STARTED
  READY
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  REVIEW
  REVISION
  APPROVED
  DONE
  BLOCKED
}

enum ProductionStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW
  REVISION
  APPROVED
  COMPLETED
  ON_HOLD
}

enum VersionStatus {
  WORKING
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ReviewType {
  INTERNAL
  ART_DIRECTOR
  CLIENT
  FINAL
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  /// Deadline passed with no decision: the discussion window closed.
  EXPIRED
}

enum RevisionStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_REVIEW
  COMPLETED
  CANCELLED
}

enum AssetType {
  CHARACTER
  ENVIRONMENT
  PROP
  MODEL
  RIG
  TEXTURE
  ANIMATION
  AUDIO
  REFERENCE
  TEMPLATE
  OTHER
}

enum RenderStatus {
  QUEUED
  RENDERING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  EMPLOYEE
  FREELANCER
  RENDER
  SOFTWARE
  HARDWARE
  AUDIO
  PRODUCTION
  /// Rent, utilities, office upkeep: studio overhead with no project.
  OFFICE
  /// Taxes and state fees.
  TAXES
  MARKETING
  OTHER
}

/// How money actually moved, for both incoming payments and expenses.
enum PaymentMethod {
  /// Bank transfer (перечисление), the default for B2B work.
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

/// What a payroll entry does to the month's pay (client item 7).
/// The sign is fixed by the type, so amounts are always entered positive.
enum PayrollEntryType {
  /// Paid out ahead of payday, subtracted from what is left to pay.
  ADVANCE
  BONUS
  PENALTY
  /// A penalty for coming in late; carries the minutes and the day.
  LATENESS
  DEDUCTION
  /// Any other accrual on top of the base salary.
  OTHER_ACCRUAL
}

enum PayrollEntryStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// Where an entry came from. Today everything is typed in; an attendance
/// integration (e.g. Verifix) or a timesheet rule will write the other two.
enum PayrollEntrySource {
  MANUAL
  TIMESHEET
  EXTERNAL
}

/// Where an attendance day's arrival and leave times came from.
enum AttendanceSource {
  /// Captured automatically: sign-in and authenticated activity in the app.
  WEB
  /// Set by hand by an administrator, with a comment.
  MANUAL
  /// Imported from an access-control system (e.g. Verifix turnstiles).
  EXTERNAL
}

/// How an arrival or a departure got its time on a WEB day.
enum AttendanceMethod {
  /// The employee pressed «Я приехал» / «Я ушёл» in the header.
  BUTTON
  /// Taken from activity: first request of the day, latest request.
  AUTO
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocumentType {
  CONTRACT
  BRIEF
  SPECIFICATION
  INVOICE
  ACT
  NDA
  OTHER
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  TASK_REVIEW
  VERSION_SUBMITTED
  VERSION_APPROVED
  CHANGES_REQUESTED
  REVISION_CREATED
  PROJECT_DEADLINE
  SHOT_DEADLINE
  RENDER_FAILED
  COMMENT_MENTION
  PROJECT_ASSIGNED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
}

// ---------------------------------------------------------------- identity

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(ARTIST)
  avatarUrl    String?
  phone        String?
  isActive     Boolean   @default(true)
  /// Set when the address was proven by entering an emailed code.
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  /// Access tokens issued before this moment are refused. Set when a password
  /// is reset, so a session stolen before the reset dies at once instead of
  /// living out its 15 minutes.
  sessionsRevokedAt DateTime?
  /// The language this person reads the interface, letters and exports in.
  /// Empty means the studio default (StudioSettings.defaultLocale).
  locale       Locale?

  // Set only for Role.CLIENT — scopes the client portal to one client (spec 36).
  clientId String? @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  employee Employee?

  emailCodes          EmailCode[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  notificationPrefs   NotificationPreference[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  auditLogs           AuditLog[]
  comments            Comment[]
  uploadedVersions    Version[]                @relation("VersionUploader")
  reviewsGiven        Review[]                 @relation("Reviewer")
  revisionsRequested  Revision[]               @relation("RevisionRequester")
  revisionsAssigned   Revision[]               @relation("RevisionAssignee")
  tasksAssigned       Task[]                   @relation("TaskAssignee")
  tasksReviewing      Task[]                   @relation("TaskReviewer")
  tasksCreated        Task[]                   @relation("TaskCreator")
  shotsAssigned       Shot[]                   @relation("ShotAssignee")
  stagesAssigned      ProjectStage[]           @relation("StageAssignee")
  shotStagesAssigned  ShotStage[]              @relation("ShotStageAssignee")
  projectsManaged     Project[]                @relation("ProjectManager")
  projectsProduced    Project[]                @relation("ProjectProducer")
  projectMemberships  ProjectMember[]
  assetsOwned         Asset[]
  expensesCreated     Expense[]
  payrollCreated      PayrollEntry[]           @relation("PayrollCreator")
  payrollApproved     PayrollEntry[]           @relation("PayrollApprover")
  salariesSet         EmployeeSalary[]
  attendanceCorrected AttendanceDay[]          @relation("AttendanceCorrector")
  documentsUploaded   Document[]
  renderJobsSubmitted RenderJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([clientId])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the token — the raw value never touches the database.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- team

model Department {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique
  description String?
  employees   Employee[]
  stages      ProjectStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt  DateTime?
  archivedAt DateTime?

  /// Files attached to this record.
  documents Document[]

  @@index([archivedAt])
  @@map("departments")
}

model Employee {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  position            String
  employmentType      EmploymentType @default(FULL_TIME)
  // Cost basis for project profitability (spec 43). Null for salaried staff.
  hourlyRate          Decimal?       @db.Decimal(12, 2)
  // Drives utilisation percentage on /team/workload (spec 32).
  weeklyCapacityHours Int            @default(40)
  status              EmployeeStatus @default(ACTIVE)
  hiredAt             DateTime?

  timesheetEntries TimesheetEntry[]
  payrollEntries   PayrollEntry[]
  salary           EmployeeSalary?
  attendanceDays   AttendanceDay[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?

  /// Files attached to this record.
  documents Document[]

  @@index([departmentId])
  @@index([status])
  @@index([archivedAt])
  @@map("employees")
}

// ---------------------------------------------------------------- clients

model Client {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  companyName String?
  email       String?
  phone       String?
  country     String?
  status      ClientStatus @default(ACTIVE)
  notes       String?

  contacts    ClientContact[]
  projects    Project[]
  payments    Payment[]
  documents   Document[]
  portalUsers User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?
  invoices   Invoice[]

  @@index([status])
  @@index([name])
  @@index([archivedAt])
  @@map("clients")
}

model ClientContact {
  id        String  @id @default(uuid()) @db.Uuid
  clientId  String  @db.Uuid
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("client_contacts")
}

// ---------------------------------------------------------------- projects

model Project {
  id          String  @id @default(uuid()) @db.Uuid
  // Human-facing identifier, e.g. AST-001 (spec 74).
  code        String  @unique
  name        String
  description String?

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectManagerId String? @db.Uuid
  projectManager   User?   @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)

  producerId String? @db.Uuid
  producer   User?   @relation("ProjectProducer", fields: [producerId], references: [id], onDelete: SetNull)

  projectType ProjectType   @default(OTHER)
  status      ProjectStatus @default(DRAFT)
  priority    Priority      @default(NORMAL)

  startDate DateTime?
  deadline  DateTime?

  // Derived from stage completion — never user-editable (spec 56).
  progress Int       @default(0)
  risk     RiskLevel @default(LOW)

  budget   Decimal? @db.Decimal(14, 2)
  currency String   @default("USD")

  members          ProjectMember[]
  stages           ProjectStage[]
  episodes         Episode[]
  scenes           Scene[]
  shots            Shot[]
  tasks            Task[]
  assets           Asset[]
  versions         Version[]
  revisions        Revision[]
  milestones       Milestone[]
  timesheetEntries TimesheetEntry[]
  expenses         Expense[]
  payments         Payment[]
  documents        Document[]
  renderJobs       RenderJob[]
  budgetRecord     ProjectBudget?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?
  invoices   Invoice[]

  @@index([clientId])
  @@index([status])
  @@index([deadline])
  @@index([projectManagerId])
  @@index([createdAt])
  @@index([archivedAt])
  @@map("projects")
}

model ProjectMember {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel String?

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// One configurable pipeline step on a project (spec 11).
model ProjectStage {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name  String
  order Int

  status   StageStatus @default(NOT_STARTED)
  progress Int         @default(0)
  /// Relative contribution to project progress (spec 56 custom stage weights).
  weight   Int         @default(1)

  startDate DateTime?
  deadline  DateTime?

  assigneeId String? @db.Uuid
  assignee   User?   @relation("StageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// Self-relation: this stage cannot start until the dependency is DONE.
  dependencyStageId String?        @db.Uuid
  dependencyStage   ProjectStage?  @relation("StageDependency", fields: [dependencyStageId], references: [id], onDelete: SetNull)
  dependents        ProjectStage[] @relation("StageDependency")

  tasks      Task[]
  shotStages ShotStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
  @@index([projectId])
  @@index([status])
  @@index([deadline])
  @@map("project_stages")
}

model Milestone {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("milestones")
}

// ---------------------------------------------------------------- production

model Episode {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number      Int
  title       String
  description String?
  /// Seconds.
  duration    Int?

  status   ProductionStatus @default(NOT_STARTED)
  progress Int              @default(0)

  startDate DateTime?
  deadline  DateTime?

  scenes Scene[]
  shots  Shot[]
  tasks  Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?

  /// Files attached to this record.
  documents Document[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([status])
  @@index([archivedAt])
  @@map("episodes")
}

model Scene {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  episodeId String?  @db.Uuid
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  sceneNumber Int
  name        String
  description String?
  duration    Int?

  status   ProductionStatus @default(NOT_STARTED)
  progress Int              @default(0)

  shots Shot[]
  tasks Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?

  /// Files attached to this record.
  documents Document[]

  @@unique([episodeId, sceneNumber])
  @@index([projectId])
  @@index([episodeId])
  @@index([status])
  @@index([archivedAt])
  @@map("scenes")
}

/// The core production unit (spec 14).
model Shot {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  episodeId String?  @db.Uuid
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  sceneId String? @db.Uuid
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  shotNumber  Int
  /// Denormalised display code, e.g. EP01_SC03_SH014 (spec 14).
  code        String
  name        String?
  description String?

  duration   Int?
  fps        Int  @default(24)
  startFrame Int?
  endFrame   Int?

  status   ProductionStatus @default(NOT_STARTED)
  progress Int              @default(0)

  assigneeId String? @db.Uuid
  assignee   User?   @relation("ShotAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  deadline DateTime?

  stages     ShotStage[]
  tasks      Task[]
  versions   Version[]
  revisions  Revision[]
  renderJobs RenderJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?

  /// Files attached to this record.
  documents        Document[]
  timesheetEntries TimesheetEntry[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([episodeId])
  @@index([sceneId])
  @@index([status])
  @@index([assigneeId])
  @@index([deadline])
  @@index([archivedAt])
  @@map("shots")
}

/// Per-shot state of one pipeline stage (spec 15).
model ShotStage {
  id      String       @id @default(uuid()) @db.Uuid
  shotId  String       @db.Uuid
  shot    Shot         @relation(fields: [shotId], references: [id], onDelete: Cascade)
  stageId String       @db.Uuid
  stage   ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  status   StageStatus @default(NOT_STARTED)
  progress Int         @default(0)

  assigneeId String? @db.Uuid
  assignee   User?   @relation("ShotStageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  startedAt   DateTime?
  completedAt DateTime?
  deadline    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shotId, stageId])
  @@index([shotId])
  @@index([stageId])
  @@index([status])
  @@map("shot_stages")
}

// ---------------------------------------------------------------- tasks

model Task {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  episodeId String?       @db.Uuid
  episode   Episode?      @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  sceneId   String?       @db.Uuid
  scene     Scene?        @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  shotId    String?       @db.Uuid
  shot      Shot?         @relation(fields: [shotId], references: [id], onDelete: SetNull)
  stageId   String?       @db.Uuid
  stage     ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  title       String
  description String?

  status   TaskStatus @default(BACKLOG)
  priority Priority   @default(NORMAL)

  assigneeId String? @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId String? @db.Uuid
  reviewer   User?   @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  estimatedHours Decimal? @db.Decimal(8, 2)
  actualHours    Decimal? @db.Decimal(8, 2)

  startDate DateTime?
  deadline  DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Archived tasks stay fully intact but drop out of active lists.
  /// Distinct from deletedAt: archiving is a workflow state a user can undo,
  /// deletion is removal.
  archivedAt DateTime?

  /// Tasks this one waits on (spec 18).
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("PrerequisiteTask")

  versions         Version[]
  revisions        Revision[]
  timesheetEntries TimesheetEntry[]
  documents        Document[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([shotId])
  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
  @@index([createdAt])
  @@index([archivedAt])
  @@map("tasks")
}

model TaskDependency {
  id String @id @default(uuid()) @db.Uuid

  /// The task that is blocked.
  taskId String @db.Uuid
  task   Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)

  /// The task that must finish first.
  dependsOnTaskId String @db.Uuid
  dependsOnTask   Task   @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

// ---------------------------------------------------------------- assets & versions

model Asset {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type         AssetType
  name         String
  description  String?
  thumbnailUrl String?
  status       ProductionStatus @default(NOT_STARTED)

  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  versions  Version[]
  documents Document[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([archivedAt])
  @@map("assets")
}

/// Immutable-ish work product. Approved versions are protected from artist deletion (spec 19).
model Version {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId  String? @db.Uuid
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  shotId  String? @db.Uuid
  shot    Shot?   @relation(fields: [shotId], references: [id], onDelete: SetNull)
  assetId String? @db.Uuid
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  versionNumber Int
  /// Display name, e.g. SH014_animation_v003 (spec 19).
  label         String

  fileUrl    String?
  previewUrl String?
  fileName   String?
  fileSize   BigInt?
  mimeType   String?

  notes  String?
  status VersionStatus @default(WORKING)

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  reviews   Review[]
  revisions Revision[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  renderJobs RenderJob[]

  @@index([projectId])
  @@index([shotId, versionNumber])
  @@index([taskId])
  @@index([assetId])
  @@index([status])
  @@map("versions")
}

model Review {
  id        String  @id @default(uuid()) @db.Uuid
  versionId String  @db.Uuid
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  reviewType ReviewType   @default(INTERNAL)
  status     ReviewStatus @default(PENDING)

  reviewerId String? @db.Uuid
  reviewer   User?   @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  comment String?

  /// Discussion window. Passing it without a decision closes the review.
  deadline DateTime?

  /// Reference material attached to the discussion.
  documents Document[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  deletedAt  DateTime?
  archivedAt DateTime?

  @@index([versionId])
  @@index([reviewerId])
  @@index([status])
  @@index([archivedAt])
  @@map("reviews")
}

model Revision {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  shotId    String?  @db.Uuid
  shot      Shot?    @relation(fields: [shotId], references: [id], onDelete: SetNull)
  taskId    String?  @db.Uuid
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  versionId String?  @db.Uuid
  version   Version? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  /// Revision round number, reported per project (spec 24).
  round       Int     @default(1)
  title       String
  description String?

  requestedById String? @db.Uuid
  requestedBy   User?   @relation("RevisionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedToId  String? @db.Uuid
  assignedTo    User?   @relation("RevisionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  priority Priority       @default(NORMAL)
  status   RevisionStatus @default(OPEN)
  deadline DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  deletedAt  DateTime?
  archivedAt DateTime?

  /// Files attached to this record.
  documents Document[]

  @@index([projectId])
  @@index([shotId])
  @@index([status])
  @@index([archivedAt])
  @@map("revisions")
}

/// Polymorphic comment thread, attachable to task / shot / version / review / revision (spec 58).
model Comment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String @db.Uuid

  message String

  parentId String?   @db.Uuid
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  /// User ids extracted from @mentions at write time.
  mentionedUserIds String[] @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([entityType, entityId])
  @@index([userId])
  @@map("comments")
}

// ---------------------------------------------------------------- time & money

model TimesheetEntry {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String? @db.Uuid
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  shotId    String? @db.Uuid
  shot      Shot?   @relation(fields: [shotId], references: [id], onDelete: SetNull)

  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(6, 2)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date])
  @@index([projectId])
  @@index([taskId])
  @@map("timesheet_entries")
}

model ProjectBudget {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  revenue     Decimal @default(0) @db.Decimal(14, 2)
  plannedCost Decimal @default(0) @db.Decimal(14, 2)
  /// Recomputed from expenses plus timesheet cost (spec 43).
  actualCost  Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("USD")

  /// The planned cost broken down by expense category, compared to the fact.
  lines ProjectBudgetLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_budgets")
}

/// Planned spend of one expense category within a project budget. The fact is
/// never stored here: it is the sum of that category's expenses.
model ProjectBudgetLine {
  id       String        @id @default(uuid()) @db.Uuid
  budgetId String        @db.Uuid
  budget   ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  category      ExpenseCategory
  plannedAmount Decimal         @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([budgetId, category])
  @@map("project_budget_lines")
}

model Expense {
  id        String   @id @default(uuid()) @db.Uuid
  /// Empty for studio overhead (rent, taxes, subscriptions) that no single
  /// project carries.
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    ExpenseCategory
  description String?
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("USD")
  date        DateTime        @db.Date

  /// Who was paid: supplier, freelancer, landlord.
  vendor         String?
  paymentMethod  PaymentMethod?
  /// Number of the primary document: receipt, act, supplier invoice.
  documentNumber String?
  /// Link to the scan of that document (cloud drive, accounting system).
  documentUrl    String?
  /// VAT included in `amount`, when the supplier charged it.
  vatAmount      Decimal?       @db.Decimal(14, 2)

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([date])
  @@index([currency, date])
  @@map("expenses")
}

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("USD")
  status   PaymentStatus @default(PENDING)

  dueDate  DateTime?
  paidDate DateTime?
  method   PaymentMethod?
  /// Bank transaction / payment order number, to match the bank statement.
  reference String?
  /// Bank or acquiring commission withheld from this payment.
  fee       Decimal        @default(0) @db.Decimal(14, 2)
  notes     String?

  invoiceId String?  @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([paidDate])
  @@index([invoiceId])
  @@map("payments")
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  number    String   @unique
  clientId  String   @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  amount   Decimal       @db.Decimal(14, 2)
  currency String        @default("USD")
  status   PaymentStatus @default(PENDING)

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  /// What the invoice is for, as printed on it.
  description String?
  /// VAT included in `amount`.
  vatAmount   Decimal? @db.Decimal(14, 2)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([issuedAt])
  @@index([dueDate])
  @@map("invoices")
}

/// One money operation on an employee's monthly pay: advance, bonus,
/// penalty (incl. lateness), deduction or other accrual (client item 7).
///
/// `source` + `externalId` let an outside system (attendance, timesheets) write
/// entries idempotently: re-sending the same external record hits the unique
/// index instead of creating a second penalty.
model PayrollEntry {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type     PayrollEntryType
  status   PayrollEntryStatus @default(DRAFT)
  /// Always positive; the type decides whether it adds to or takes from pay.
  amount   Decimal            @db.Decimal(14, 2)
  currency String             @default("USD")

  /// The day it happened (the late arrival, the advance handed out).
  date   DateTime @db.Date
  /// Payroll month it counts towards, as YYYY-MM.
  period String   @db.VarChar(7)

  /// Lateness only: how late, in minutes.
  lateMinutes Int?
  reason      String?

  source     PayrollEntrySource @default(MANUAL)
  externalId String?

  createdById  String?   @db.Uuid
  createdBy    User?     @relation("PayrollCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?   @db.Uuid
  approvedBy   User?     @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([employeeId, period])
  @@index([period])
  @@index([status])
  @@index([type])
  @@map("payroll_entries")
}

/// Base monthly salary, kept apart from Employee so the employees API (open
/// to anyone with team:view) never carries pay; only payroll reads it.
model EmployeeSalary {
  employeeId String   @id @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("USD")

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_salaries")
}

/// One employee's working day (Verifix-style attendance control).
///
/// Keyed by the studio-local calendar date. firstSeenAt/lastSeenAt are what
/// the app itself observed (sign-in, authenticated requests) and are never
/// edited; checkInAt/checkOutAt are the times that count. On WEB rows they
/// follow the observations; a manual correction or an external import sets
/// them and moves the source, after which observations stop overwriting them.
model AttendanceDay {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Studio-local calendar day (StudioSettings.timezone).
  date DateTime @db.Date

  firstSeenAt DateTime?
  lastSeenAt  DateTime?

  checkInAt  DateTime?
  checkOutAt DateTime?
  /// BUTTON once the employee pressed «Я приехал»; AUTO while the arrival is
  /// only the first activity of the day. Lateness counts from checkInAt
  /// either way, and the board flags AUTO days as «без отметки».
  checkInMethod  AttendanceMethod?
  /// BUTTON once «Я ушёл» was pressed: later activity no longer moves it.
  checkOutMethod AttendanceMethod?

  /// Minutes past the scheduled start; 0 when on time or on a day off.
  lateMinutes   Int @default(0)
  /// checkOutAt minus checkInAt, in minutes.
  workedMinutes Int @default(0)

  source     AttendanceSource @default(WEB)
  /// Record id in the external system, for idempotent imports.
  externalId String?

  /// Manual correction: who, when and why.
  correctedById String?   @db.Uuid
  correctedBy   User?     @relation("AttendanceCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  correctedAt   DateTime?
  comment       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@unique([source, externalId])
  @@index([date])
  @@map("attendance_days")
}

model Document {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId  String?  @db.Uuid
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Attachments made from a task page (photo, video, audio, documents).
  taskId String? @db.Uuid
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// Material attached to a review, so the discussion has something to look at.
  reviewId String? @db.Uuid
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  /// Source files and references filed under a library asset.
  assetId String? @db.Uuid
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Reference boards and briefs filed under an episode.
  episodeId String?  @db.Uuid
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  /// Reference material filed under a scene.
  sceneId String? @db.Uuid
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  /// Plates, references and notes filed under a shot.
  shotId String? @db.Uuid
  shot   Shot?   @relation(fields: [shotId], references: [id], onDelete: SetNull)

  /// Material showing what the revision is about.
  revisionId String?   @db.Uuid
  revision   Revision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  /// Documents belonging to a department.
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// Personnel documents for an employee.
  employeeId String?   @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  /// Scene files or logs attached to a render job.
  renderJobId String?    @db.Uuid
  renderJob   RenderJob? @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  type     DocumentType
  name     String
  fileUrl  String
  fileSize BigInt?
  mimeType String?

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  archivedAt DateTime?

  @@index([projectId])
  @@index([clientId])
  @@index([taskId])
  @@index([reviewId])
  @@index([assetId])
  @@index([renderJobId])
  @@index([episodeId])
  @@index([sceneId])
  @@index([shotId])
  @@index([revisionId])
  @@index([departmentId])
  @@index([employeeId])
  @@index([type])
  @@index([archivedAt])
  @@map("documents")
}

// ---------------------------------------------------------------- render

model RenderNode {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  hostname   String?
  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?

  jobs RenderJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("render_nodes")
}

model RenderJob {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shotId    String?  @db.Uuid
  shot      Shot?    @relation(fields: [shotId], references: [id], onDelete: SetNull)
  versionId String?  @db.Uuid
  version   Version? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  nodeId String?     @db.Uuid
  node   RenderNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  startFrame Int?
  endFrame   Int?

  status   RenderStatus @default(QUEUED)
  progress Int          @default(0)
  priority Priority     @default(NORMAL)

  submittedById String? @db.Uuid
  submittedBy   User?   @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  /// Scene files and logs attached to this job.
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt  DateTime?
  archivedAt DateTime?

  @@index([projectId])
  @@index([status])
  @@index([shotId])
  @@index([archivedAt])
  @@map("render_jobs")
}

// ---------------------------------------------------------------- notifications & audit

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  body    String?
  /// Deep link to the originating entity.
  linkUrl String?

  entityType String?
  entityId   String? @db.Uuid

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

/// Business-visible feed shown on project pages (spec 49).
model ActivityLog {
  id      String  @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String @db.Uuid
  action     String

  /// Free-form payload, e.g. { from: "IN_PROGRESS", to: "REVIEW" }.
  metadata Json?

  /// Denormalised so the project feed is a single indexed read.
  projectId String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([projectId, createdAt])
  @@index([actorId])
  @@map("activity_logs")
}

/// Security-relevant trail: logins, permission changes, deletions (spec 50).
model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String? @db.Uuid

  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One-time code emailed to prove an address (login confirmation).
model EmailCode {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the code: a leaked table must not hand out working codes.
  codeHash String
  purpose  String @default("LOGIN")

  expiresAt  DateTime
  consumedAt DateTime?
  /// Wrong guesses so far; the code dies before brute force pays off.
  attempts   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_codes")
}

/// A single-use "reset your password" link, mailed on request.
///
/// Separate from EmailCode: a link token is looked up by its hash (unique),
/// not by user, and carries where the request came from for the audit trail.
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token: the raw value exists only in the letter.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdIp String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Studio-wide configuration (spec 6).
///
/// Exactly one row, keyed by a constant id: the application serves one studio,
/// and a table that can hold two of these invites the question of which one is
/// in force. Everything here is optional so a fresh install has a working
/// settings page before anybody has filled anything in.
model StudioSettings {
  id String @id @default("studio")

  name      String  @default("Aster Studio")
  legalName String?
  email     String?
  phone     String?
  website   String?
  address   String?
  logoUrl   String?

  /// Defaults offered when a new project, invoice or expense is created.
  currency String @default("USD")
  timezone String @default("Asia/Tashkent")

  /// Prefix for derived invoice numbers, e.g. INV- in INV-0001.
  invoicePrefix String @default("INV-")

  /// Interface language for everyone who has not picked their own, and for
  /// the sign-in page before anyone is known.
  defaultLocale Locale @default(ru)

  /// Work schedule for attendance control, in studio-local time (HH:MM).
  workDayStart     String @default("09:00")
  workDayEnd       String @default("18:00")
  /// Arriving within this many minutes after the start is not late.
  lateGraceMinutes Int    @default(10)
  /// ISO weekdays that are working days: 1 = Monday ... 7 = Sunday.
  workWeekdays     Int[]  @default([1, 2, 3, 4, 5])
  /// Lateness fine in the studio currency: per late day plus per late minute.
  /// Both zero means fines are not calculated.
  latePenaltyPerDay    Decimal @default(0) @db.Decimal(14, 2)
  latePenaltyPerMinute Decimal @default(0) @db.Decimal(14, 2)

  /// SMTP. Empty values fall back to the environment, so a deployment that
  /// configures mail through env keeps working with no row here at all.
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  /// Never returned by the API: it goes in, it does not come back out.
  smtpPassword String?
  smtpFrom     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_settings")
}

/// A named list of stages a new project can be seeded with (spec 84).
///
/// These used to live in packages/config as a constant, which meant a studio
/// could not add its own pipeline without a deploy.
model PipelineTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  /// Stage names in order. A plain array: stages carry no data of their own
  /// until a project instantiates them.
  stages String[]

  /// Offered first in the project form. Enforced by the service, not the
  /// database, because "at most one" is not a constraint Postgres expresses.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pipeline_templates")
}

/// What a role may do, as edited from Settings.
///
/// One row per role that the studio has changed; a role without a row keeps
/// the defaults compiled into @astir/types. The whole list is stored rather
/// than a diff, so reading a role's rights is one lookup with no merging.
model RolePermission {
  role        Role     @id
  permissions String[]

  updatedAt DateTime @updatedAt

  @@map("role_permissions")
}
