# Aster ERP — the proxy half of the __DOMAIN__ vhost.
#
# Included from inside a server block by both nginx.conf.template (plain HTTP,
# before a certificate exists) and nginx-tls.conf.template (after certbot). It
# lives in its own file so the two vhosts cannot drift apart: there is exactly
# one description of how a request reaches the app.
#
# Placeholders __DOMAIN__, __WEB_PORT__ and __APP_DIR__ are filled in by deploy.sh.

# The global nginx.conf only gzips text/html. Scripts, styles and JSON are the
# bulk of what travels, so they are compressed here; the vary header keeps a
# shared cache from handing a gzip body to a client that did not ask for one.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/javascript application/javascript application/json
           application/xml image/svg+xml font/woff2 application/manifest+json;

# Hashed build assets: served straight from the release directory with the
# .gz/.br files the build already wrote (gzip_static), never from the Node
# process, and cached for a year because the name changes with the content.
location /_nuxt/ {
    alias __APP_DIR__/current/apps/web/.output/public/_nuxt/;
    gzip_static on;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
    try_files $uri =404;
}

# Uploads live on disk next to the app. Reading them here skips two proxy
# hops (nginx -> Nuxt -> API) per image; the API keeps its own /uploads route
# for local development where there is no nginx.
location /uploads/ {
    alias __APP_DIR__/storage/;
    add_header Cache-Control "public, max-age=3600";
    access_log off;
    try_files $uri =404;
}

location / {
    proxy_pass http://erp_astir_task_web;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # Nuxt streams its server-rendered response; buffering would delay first
    # paint for no benefit.
    proxy_buffering off;
    proxy_read_timeout 120s;
    proxy_connect_timeout 5s;

    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $erp_connection_upgrade;
}

# Uploaded media can be large; the API enforces its own limit above this one.
client_max_body_size 64m;

access_log /var/log/nginx/__DOMAIN__.access.log;
error_log  /var/log/nginx/__DOMAIN__.error.log;
