# Aster ERP — the proxy half of the __DOMAIN__ vhost.
#
# Included from inside a server block by both nginx.conf.template (plain HTTP,
# before a certificate exists) and nginx-tls.conf.template (after certbot). It
# lives in its own file so the two vhosts cannot drift apart: there is exactly
# one description of how a request reaches the app.
#
# Placeholders __DOMAIN__ and __WEB_PORT__ are filled in by deploy.sh.

location / {
    proxy_pass http://erp_astir_task_web;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # Nuxt streams its server-rendered response; buffering would delay first
    # paint for no benefit.
    proxy_buffering off;
    proxy_read_timeout 120s;
    proxy_connect_timeout 5s;

    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $erp_connection_upgrade;
}

# Uploaded media can be large; the API enforces its own limit above this one.
client_max_body_size 64m;

access_log /var/log/nginx/__DOMAIN__.access.log;
error_log  /var/log/nginx/__DOMAIN__.error.log;
