# Aster ERP — __DOMAIN__, before a certificate exists.
#
# Everything goes to the Nuxt server, which already proxies /api and /uploads to
# the Express API on this same machine. Splitting those out here would duplicate
# routing the application owns, and would drift the moment it changes.
#
# Placeholders __DOMAIN__ and __WEB_PORT__ are filled in by deploy.sh.

# A WebSocket upgrade must not leak into ordinary requests. A literal
# "Connection: upgrade" on every proxied request makes Node treat the connection
# as non-keep-alive and close it once the response is written, while nginx keeps
# that same socket in the keepalive pool below and hands it to the next request.
# Reusing an already-closed socket is what reaches the browser as a sporadic 502
# on one asset while the rest of the page loads. An empty Upgrade must therefore
# map to an empty Connection, which is also what the keepalive pool requires.
# The name is prefixed because this box hosts other sites that may define their
# own $connection_upgrade, and a duplicate map name fails `nginx -t` for all.
map $http_upgrade $erp_connection_upgrade {
    default upgrade;
    ""      "";
}

upstream erp_astir_task_web {
    server 127.0.0.1:__WEB_PORT__;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot writes its challenge here, before any redirect applies.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/snippets/__DOMAIN__.proxy.conf;
}
