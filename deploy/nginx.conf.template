# Aster ERP — __DOMAIN__
#
# Everything goes to the Nuxt server, which already proxies /api and /uploads to
# the Express API on this same machine. Splitting those out here would duplicate
# routing the application owns, and would drift the moment it changes.
#
# Placeholders __DOMAIN__ and __WEB_PORT__ are filled in by deploy.sh.

upstream erp_astir_task_web {
    server 127.0.0.1:__WEB_PORT__;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot writes its challenge here, before any redirect applies.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://erp_astir_task_web;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Nuxt streams its server-rendered response; buffering would delay first
        # paint for no benefit.
        proxy_buffering off;
        proxy_read_timeout 120s;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Uploaded media can be large; the API enforces its own limit above this one.
    client_max_body_size 64m;

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log;
}
