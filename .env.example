# Copy to apps/api/.env and fill in real values.
NODE_ENV=development
PORT=4000

# Postgres on 95.46.96.48, reached through the SSH tunnel on 5433.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/astir_erp?schema=public"

JWT_ACCESS_SECRET="replace-with-48-random-bytes"
JWT_REFRESH_SECRET="replace-with-48-random-bytes"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

APP_URL=http://127.0.0.1:9990
API_URL=http://127.0.0.1:4000
COOKIE_SECURE=false

STORAGE_PROVIDER=local
STORAGE_PATH=./storage
LOG_LEVEL=info
